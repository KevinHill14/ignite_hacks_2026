# --- Secrets: never commit -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
client_secret*.json
service-account*.json
credentials.json
token.json

# --- Uploads / scratch -----------------------------------------------------
uploads/
tmp/
# PDFs are blocked by default so a personal document is never committed by
# accident. The example corpus is the one deliberate exception.
*.pdf
*.docx
!syllabus_examples/*.pdf
!syllabus_examples/*.docx

# --- Node ------------------------------------------------------------------
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- n8n -------------------------------------------------------------------
n8n/.n8n/
n8n/data/

# --- OS / editor -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
