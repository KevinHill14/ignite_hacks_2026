# =============================================================================
# Syllabus -> Calendar  ::  environment template
# =============================================================================
# New to .env files? Read docs/TEAMMATE-SETUP.md first — it walks the whole
# thing and tells you which of these you can safely ignore.
#
# The short version:
#   1. npm run gen:secrets     <- creates your .env from this file and fills
#                                 in the two random secrets automatically
#   2. paste your own Anthropic key into ANTHROPIC_API_KEY below
#   3. leave everything else alone
#
# A .env file is just NAME=value, one per line. No quotes, no spaces around
# the "=". It holds passwords and keys, which is exactly why it is gitignored
# and must never be committed.
#
# MOST TEAM MEMBERS DO NOT NEED AN API KEY AT ALL. If you are doing design,
# mobile, accessibility, docs, or the pitch, run the app and click "See a
# worked example" — it renders the whole product with no key and no cost.
# =============================================================================

# --- n8n runtime -------------------------------------------------------------
# 32+ random bytes, base64. Encrypts every credential in n8n's store at rest.
# Changing this after credentials are saved makes them permanently unreadable.
N8N_ENCRYPTION_KEY=

# IANA timezone used to resolve bare syllabus dates ("Oct 14") into instants.
GENERIC_TIMEZONE=America/Toronto

# Which model does the extraction. Change this and restart n8n to swap — no
# workflow edit needed. Develop on the cheaper model, switch for the real run.
#   claude-opus-5    best date inference, ~$0.12 / syllabus
#   claude-sonnet-5  strong, ~$0.05 / syllabus
#   claude-haiku-4-5 cheapest, ~$0.024 / syllabus
EXTRACTION_MODEL=claude-sonnet-5

# Public base URL n8n advertises for its webhooks. Keep the trailing slash.
WEBHOOK_URL=http://localhost:5678/

# --- Web app -> n8n handoff --------------------------------------------------
# The pipeline entrypoint the Next.js app POSTs to.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/syllabus-ingest

# Shared secret. The web app sends it as `X-Ingest-Token`; the n8n webhook
# node rejects anything else. Without this, anyone who can reach port 5678
# can push events into your calendar.
INGEST_TOKEN=

# Largest syllabus the app will accept, in megabytes.
MAX_UPLOAD_MB=10

# --- Public deployment guards ------------------------------------------------
# Leave BOTH of these alone for local work. They exist for the moment this is
# on a public URL, where "anyone can reach it" and "every upload costs $0.16"
# are the same sentence.

# One shared password for the whole app. Blank = no gate at all, which is what
# you want locally. Set it and every page and API route requires a sign-in
# first. This is not a user system — everyone shares one password, and anyone
# holding it can do anything the app can.
APP_PASSWORD=

# Per-IP upload caps. The minute limit stops a stuck refresh; the daily limit
# is the actual budget guard. In-memory, so they reset on redeploy and are not
# shared across instances — fine for one service, not a substitute for Redis
# at scale.
RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_DAY=25

# --- Anthropic API key -------------------------------------------------------
# Get your OWN key at https://console.anthropic.com -> API Keys -> Create Key.
# Do not reuse a teammate's: one shared key means one shared bill, no way to
# tell who spent what, and if it leaks everyone has to rotate at once.
#
# Only needed if you are working on the extraction pipeline. Design, docs, and
# UI work do not need it — use "See a worked example" instead.
#
# Roughly $0.05 per syllabus on claude-sonnet-5.
ANTHROPIC_API_KEY=

# --- Google Calendar ---------------------------------------------------------
# Which calendar deadlines get written to.
#
# START WITH A THROWAWAY CALENDAR. In Google Calendar: left sidebar -> "+" ->
# "Create new calendar", name it something like "Syllabus Test", then open its
# Settings -> "Integrate calendar" and copy the Calendar ID. It looks like:
#     c_a1b2c3d4e5f6@group.calendar.google.com
#
# A bad extraction should pollute something you can delete in one click, not
# your real schedule. Switch this to `primary` once you trust the output.
GOOGLE_CALENDAR_ID=primary

# OAuth client from Google Cloud Console (APIs & Services -> Credentials ->
# Create credentials -> OAuth client ID -> Web application), with redirect URI:
#     http://localhost:5678/rest/oauth2-credential/callback
#
# Put them here and `npm run n8n:setup` builds the n8n credential for you, so
# all you do in the browser is click Connect. Leave blank to skip Google
# entirely — the pipeline still extracts everything and still shows the full
# cost breakdown; only the calendar writes report as failed.
#
# Enable BOTH "Google Calendar API" and "Google Drive API" on the project, and
# add yourself as a test user on the OAuth consent screen.
# Full walkthrough in docs/DEPLOY.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Google Drive (optional, hands-free ingest) -------------------------------
# The Drive trigger node ships disabled. Enable it in the n8n UI and point it
# at a folder if you want syllabi to import just by dropping them in.
# Scope: drive.readonly — the pipeline never writes to Drive.
